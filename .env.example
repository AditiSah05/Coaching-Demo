# Copy to .env.local. Enables live Google reviews on the home page.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Vercel / any Postgres: when set (and not on Cloudflare), content and images are stored here. See docs/DEPLOY-VERCEL.md
DATABASE_URL=
# The public address, used in canonical links and the sitemap. Optional: taken from the request when empty.
SITE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
